{
  "name": "prodlint",
  "version": "0.9.5",
  "description": "Production readiness for vibe-coded apps — know your AI code is ready to ship",
  "license": "MIT",
  "author": "prodlint contributors",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/prodlint/prodlint"
  },
  "bugs": {
    "url": "https://github.com/prodlint/prodlint/issues"
  },
  "homepage": "https://prodlint.com",
  "mcpName": "io.github.prodlint/prodlint",
  "bin": {
    "prodlint": "./dist/cli.js",
    "prodlint-mcp": "./dist/mcp.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "action.yml"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node dist/cli.js .",
    "audit:supply-chain": "node scripts/supply-chain-audit.cjs",
    "verify:release": "node scripts/verify-release.cjs",
    "sync:versions": "node scripts/sync-versions.cjs",
    "version": "node scripts/sync-versions.cjs && git add server.json packages/prodlint-mcp/package.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.7",
    "@babel/types": "^7.29.7",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lint",
    "linter",
    "security",
    "ai",
    "ai-code",
    "vibe-coding",
    "production-readiness",
    "code-quality",
    "code-scanner",
    "next.js",
    "react",
    "typescript",
    "static-analysis",
    "cli",
    "scanner",
    "mcp",
    "mcp-server",
    "cursor",
    "copilot",
    "v0",
    "bolt",
    "windsurf",
    "claude",
    "github-action",
    "eslint-alternative",
    "devtools"
  ]
}
